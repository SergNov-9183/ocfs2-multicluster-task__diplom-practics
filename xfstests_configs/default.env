# Профиль default: базовые generic-тесты xfstests на OCFS2.
# Используется deploy_ocfs2_cluster.sh

XFSTESTS_PROFILE=default
# mkfs: тип datafiles, без квот/refcount — типичный «файловый» том
MKFS_TYPE=datafiles
MKFS_FEATURES=

# Только TEST_DEV (общий DRBD). Scratch — отдельный loop в контейнере.
XFSTESTS_GROUPS=
# Явный список: короче -g auto, реально исполняется на OCFS2 без NFS/quota.
XFSTESTS_TESTS="generic/001 generic/002 generic/005 generic/006 generic/007 generic/010 generic/011 generic/013 generic/014 generic/015 generic/020 generic/069 generic/080 generic/084 generic/112 generic/124 generic/125 generic/241 generic/258 generic/269 generic/270 generic/286"

XFSTESTS_TIMEOUT=420
SCRATCH_SIZE_MB=512
MOUNT_OPTIONS=
