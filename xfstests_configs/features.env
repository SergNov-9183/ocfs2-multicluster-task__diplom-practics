# Профиль features: mkfs с xattr/acl/indexed-dirs/refcount + тесты атрибутов и clone.
# Используется deploy_ocfs2_cluster_2.sh

XFSTESTS_PROFILE=features
MKFS_TYPE=datafiles
MKFS_FEATURES="backup-super,sparse,unwritten,inline-data,indexed-dirs,xattr,acl,refcount"

XFSTESTS_GROUPS=
XFSTESTS_TESTS="generic/001 generic/002 generic/007 generic/013 generic/020 generic/062 generic/069 generic/079 generic/097 generic/105 generic/126 generic/192 generic/209 generic/215 generic/228 generic/241 generic/307 generic/377 generic/478"

XFSTESTS_TIMEOUT=480
SCRATCH_SIZE_MB=768
MOUNT_OPTIONS="user_xattr,acl"
